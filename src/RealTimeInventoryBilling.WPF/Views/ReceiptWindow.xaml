<Window x:Class="RealTimeInventoryBilling.WPF.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Receipt Preview" Height="580" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Receipt Generated" Foreground="#10B981" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtReceipt" Background="Transparent" Foreground="#F8FAFC"
                         FontFamily="Consolas, Courier New" FontSize="12" IsReadOnly="True"
                         BorderThickness="0" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="🖨 Print / Copy Receipt" Click="BtnPrint_Click" Background="#2563EB" Foreground="#FFFFFF"
                    Padding="14,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="Close" Click="BtnClose_Click" Background="#334155" Foreground="#F8FAFC"
                    Padding="14,8" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
