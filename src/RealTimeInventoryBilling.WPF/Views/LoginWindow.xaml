<Window x:Class="RealTimeInventoryBilling.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Real-Time Inventory &amp; Billing POS" 
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Padding="32">
        <StackPanel VerticalAlignment="Center">
            <!-- Header Icon & Brand -->
            <Border Background="#1E293B" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="⚡" FontSize="32" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <TextBlock Text="INVENTORY &amp; BILLING" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
            <TextBlock Text="Real-Time Desktop POS Terminal (MVVM)" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,24"/>

            <!-- Error Banner -->
            <Border Background="#7F1D1D" CornerRadius="6" Padding="10" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Form -->
            <TextBlock Text="Username" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="14" Margin="0,0,0,16">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Password" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" PasswordChanged="PasswordBox_PasswordChanged"
                         Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="14" Margin="0,0,0,20">
                <PasswordBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>

            <Button Content="SIGN IN TO TERMINAL" Command="{Binding LoginCommand}"
                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14"
                    Padding="0,12" Cursor="Hand" BorderThickness="0" Margin="0,0,0,24">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Quick Demo Login Presets -->
            <TextBlock Text="Quick Fill Roles for Evaluation:" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <UniformGrid Columns="3" Margin="0,0,0,8">
                <Button Content="Cashier" Command="{Binding QuickFillCashierCommand}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" Margin="2" Padding="4,6" Cursor="Hand"/>
                <Button Content="Admin" Command="{Binding QuickFillAdminCommand}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" Margin="2" Padding="4,6" Cursor="Hand"/>
                <Button Content="Manager" Command="{Binding QuickFillManagerCommand}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" Margin="2" Padding="4,6" Cursor="Hand"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
