<UserControl x:Class="RealTimeInventoryBilling.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RealTimeInventoryBilling.WPF.Converters"
             Background="#0F172A"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:StockBadgeBrushConverter x:Key="StockBadgeBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL CATALOG ITEMS" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalItemsCount}" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="LOW STOCK ITEMS ALERT" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LowStockCount}" Foreground="#EF4444" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search & Actions Bar -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="Search Catalog:" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC"
                         BorderBrush="#334155" Padding="8,4" FontSize="14" Width="260">
                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                </TextBox>
                <Button Content="↻ Refresh Stock" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                        Background="#334155" Foreground="#F8FAFC" Padding="12,6" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- Stock Table -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12">
            <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#182234"
                      Foreground="#F8FAFC" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="120" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="150"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="100"/>
                    <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPrice, Converter={StaticResource CurrencyConverter}}" Width="100"/>
                    <DataGridTextColumn Header="Reorder Min" Binding="{Binding LowStockThreshold}" Width="100"/>

                    <DataGridTemplateColumn Header="Current Stock" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsLowStock, Converter={StaticResource StockBadgeBrushConverter}}"
                                        CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CurrentStock, StringFormat='{}{0} in stock'}" 
                                               Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
