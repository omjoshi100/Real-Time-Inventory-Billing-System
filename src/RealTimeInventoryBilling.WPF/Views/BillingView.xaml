<UserControl x:Class="RealTimeInventoryBilling.WPF.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RealTimeInventoryBilling.WPF.Converters"
             Background="#0F172A"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:StockBadgeBrushConverter x:Key="StockBadgeBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANE: PRODUCT SEARCH & CATALOG -->
        <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barcode & Search Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Barcode Scanner Input -->
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0">
                        <Grid Margin="8,4">
                            <TextBlock Text="Scan / Enter Barcode..." Foreground="#64748B" IsHitTestVisible="False"
                                       Visibility="{Binding BarcodeInput, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
                            <TextBox Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" 
                                     Foreground="#38BDF8" BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                                     KeyDown="BarcodeInput_KeyDown"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="⚡ Scan" Command="{Binding ScanBarcodeCommand}"
                            Background="#334155" Foreground="#F8FAFC" Padding="12,6" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Text Search -->
                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                        <Grid Margin="8,4">
                            <TextBlock Text="Search name or SKU..." Foreground="#64748B" IsHitTestVisible="False"
                                       Visibility="{Binding SearchQuery, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" 
                                     Foreground="#F8FAFC" BorderThickness="0" FontSize="14"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Section Title & Refresh -->
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Product Catalog" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="↻ Refresh Stock" Command="{Binding RefreshCatalogCommand}" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                </DockPanel>

                <!-- Catalog Grid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Catalog}" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#182234"
                          Foreground="#F8FAFC" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155" HeadersVisibility="Column" SelectionMode="Single">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="80"/>
                        
                        <!-- Stock Level with Warning Badge -->
                        <DataGridTemplateColumn Header="Stock" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsLowStock, Converter={StaticResource StockBadgeBrushConverter}}"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CurrentStock, StringFormat='{}{0} in stock'}" 
                                                   Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Column -->
                        <DataGridTemplateColumn Header="Action" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+ Add" 
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                                            Padding="6,3" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Status Message -->
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="12" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- RIGHT PANE: ACTIVE CART & CHECKOUT -->
        <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Active Cart" Foreground="#F8FAFC" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Button Content="Clear Cart" Command="{Binding ClearCartCommand}" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                </DockPanel>

                <!-- Cart Items List -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#182234"
                          Foreground="#F8FAFC" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                        
                        <!-- Qty Controls -->
                        <DataGridTemplateColumn Header="Qty" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-" Command="{Binding DataContext.DecrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Background="#334155" Foreground="#FFFFFF" Width="20" Height="20" Margin="0,0,4,0" Cursor="Hand"/>
                                        <TextBlock Text="{Binding Quantity}" Foreground="#F8FAFC" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0"/>
                                        <Button Content="+" Command="{Binding DataContext.IncrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Background="#334155" Foreground="#FFFFFF" Width="20" Height="20" Margin="4,0,0,0" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}" Width="70" FontWeight="Bold"/>

                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Financial Calculation & Payment Card -->
                <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Subtotal -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="SubTotal" Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock Text="{Binding SubTotal, Converter={StaticResource CurrencyConverter}}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Tax -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Tax (5.0%)" Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock Text="{Binding TaxAmount, Converter={StaticResource CurrencyConverter}}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Discount -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Discount ($)" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#F8FAFC"
                                     BorderBrush="#334155" Padding="6,2" Width="80" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </DockPanel>

                        <Separator Background="#334155" Margin="0,4,0,8"/>

                        <!-- Grand Total -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="GRAND TOTAL" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}}" Foreground="#10B981" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Amount Paid / Tendered -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Tender Amount ($)" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#10B981"
                                     BorderBrush="#334155" Padding="8,4" FontSize="16" FontWeight="Bold" Width="100" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </DockPanel>

                        <!-- Change Due -->
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Change Due:" Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource CurrencyConverter}}" Foreground="#38BDF8" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Complete Sale Button -->
                        <Button Content="✓ COMPLETE SALE &amp; PRINT RECEIPT" Command="{Binding CheckoutCommand}"
                                Background="#10B981" Foreground="#022C22" FontSize="14" FontWeight="Bold"
                                Padding="0,12" Cursor="Hand" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
