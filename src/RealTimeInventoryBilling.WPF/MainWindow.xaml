<Window x:Class="RealTimeInventoryBilling.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RealTimeInventoryBilling.WPF.ViewModels"
        xmlns:views="clr-namespace:RealTimeInventoryBilling.WPF.Views"
        xmlns:converters="clr-namespace:RealTimeInventoryBilling.WPF.Converters"
        Title="Real-Time Retail POS &amp; Inventory - WPF Client (MVVM)" 
        Height="800" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- View Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Real-time Alert Banner -->
            <RowDefinition Height="*"/>    <!-- Main View Content -->
            <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION HEADER -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="INVENTORY &amp; BILLING" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WPF MVVM CLIENT" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- Right Side: User Profile & SignalR Pill & Logout -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Navigation Tabs -->
                    <Button Content="POS Cashier" Command="{Binding NavigateBillingCommand}"
                            Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="Live Stock" Command="{Binding NavigateInventoryCommand}"
                            Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,16,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- SignalR Status Indicator -->
                    <Border Background="#0F172A" CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionStatus, StringFormat='{}SignalR: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- User Name -->
                    <TextBlock Text="{Binding CurrentUser.FullName, StringFormat='{}👤 {0}'}" 
                               Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Logout Button -->
                    <Button Content="Sign Out" Command="{Binding LogoutCommand}"
                            Background="#7F1D1D" Foreground="#FECACA" FontWeight="SemiBold"
                            Padding="10,5" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- REAL-TIME LOW STOCK ALERT BANNER (PUSHED VIA SIGNALR) -->
        <Border Grid.Row="1" Background="#EF4444" Padding="14,10"
                Visibility="{Binding IsAlertVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock Text="🚨 REAL-TIME LOW STOCK ALERT: " FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ActiveAlert.Name, StringFormat='{}&quot;{0}&quot;'}" FontWeight="Bold" Foreground="#FEF08A" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ActiveAlert.CurrentStock, StringFormat='{} is down to only {0} items in inventory!'}" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>

                <Button Content="Dismiss ✕" Command="{Binding DismissAlertCommand}" HorizontalAlignment="Right"
                        Background="#991B1B" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,4" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- MAIN VIEW AREA -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>

        <!-- FOOTER BAR -->
        <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock Text="Ready | Enterprise ACID Stored Procedures &amp; Real-Time SignalR Core" Foreground="#64748B" FontSize="11"/>
                <TextBlock Text="Role-Based Access Control Active" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
